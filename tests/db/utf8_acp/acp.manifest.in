<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins the ANSI code page (ACP) of a test binary.

  The ACP is fixed when the process starts and cannot be changed from inside it,
  so the only way to exercise a different one is to bake this setting into the
  executable. Generated by CMakeLists.txt in this directory, once per code page
  under test.

  A locale name (for example zh-CN) selects that locale's legacy code page and
  requires Windows 11 / Server 2022 or newer; "UTF-8" works since Windows 10
  1903. On older systems the setting is ignored and the process keeps the system
  ACP, which the test detects at runtime and reports as skipped.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity type="win32" name="zvec.tests.@ZVEC_ACP_TARGET@"
                    version="1.0.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage
          xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">@ZVEC_ACP_LOCALE@</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
